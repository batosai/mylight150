#!/usr/bin/env sh
# Start every development process at once (foreman-style Procfile).
# Processes are declared in the `concurrently` file at the project root.
# Usage: ./bin/dev  (or npm run dev)

set -e

cd "$(dirname "$0")/.."

# Force a development environment so production dot-env files are never loaded.
export NODE_ENV="${NODE_ENV:-development}"

PROCFILE="concurrently"

if [ ! -f "$PROCFILE" ]; then
  echo "bin/dev: '$PROCFILE' file not found at the project root." >&2
  exit 1
fi

names=""

# Each iteration pushes the name onto $names and the command onto "$@".
while IFS= read -r line || [ -n "$line" ]; do
  # Skip blank lines and comments
  case "$line" in
    '' | \#*) continue ;;
  esac

  # "name: command" format — otherwise generate a name (proc1, proc2, ...)
  name=$(printf '%s' "$line" | sed -n 's/^\([A-Za-z0-9_-]\{1,\}\):[[:space:]]\{1,\}.*$/\1/p')
  if [ -n "$name" ]; then
    cmd=$(printf '%s' "$line" | sed 's/^[A-Za-z0-9_-]\{1,\}:[[:space:]]\{1,\}//')
  else
    cmd="$line"
    name="proc$(( $# + 1 ))"
  fi

  names="${names:+$names,}$name"
  set -- "$@" "$cmd"
done < "$PROCFILE"

if [ "$#" -eq 0 ]; then
  echo "bin/dev: no command declared in '$PROCFILE'." >&2
  exit 1
fi

exec npx --yes concurrently@10 \
  --kill-others \
  --prefix "[{name}]" \
  --names "$names" \
  --prefix-colors "auto" \
  --handle-input \
  "$@"
